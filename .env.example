# Copy to .env and fill in. Every key is optional: missing keys switch that step to mock mode.

# Gemma (Google AI Studio) - reads product photos, and is the base/fallback writer
GOOGLE_API_KEY=
# GEMINI_API_KEY=            # alternative name, used if GOOGLE_API_KEY is empty
GEMMA_MODEL=gemma-3-27b-it

# Photo reader backend: ollama (local gemma3:4b) | gemma_api (hosted) | mock
VISION_BACKEND=ollama
# Listing writer backend: ollama (local fine-tune) | tinker | gemma | mock
# If the chosen one fails, the app falls back: ollama -> tinker -> gemma -> mock
WRITER_BACKEND=ollama

# Local Ollama server and model names
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_WRITER_MODEL=listsmart-writer   # use qwen3:8b to try the base model
# true = nothing leaves the laptop: no SerpApi, no hosted models
OFFLINE_MODE=false
# Where seller feedback is saved (default: data/feedback.jsonl in the project root)
# FEEDBACK_PATH=

# Tinker fine-tuned writer
TINKER_API_KEY=
TINKER_MODEL_PATH=           # tinker://... sampler checkpoint from finetune/
TINKER_BASE_MODEL=Qwen/Qwen3-8B
TINKER_RENDERER=qwen3_disable_thinking   # must match finetune/train.py

# SerpApi Google Shopping competitor prices
SERPAPI_KEY=
