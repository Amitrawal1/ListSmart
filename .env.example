# Copy to .env and fill in. Every key is optional: missing keys switch that step to mock mode.

# Gemma (Google AI Studio) - reads product photos, and is the base/fallback writer
GOOGLE_API_KEY=
# GEMINI_API_KEY=            # alternative name, used if GOOGLE_API_KEY is empty
GEMMA_MODEL=gemma-3-27b-it

# Listing writer backend: tinker | gemma | mock
WRITER_BACKEND=mock

# Tinker fine-tuned writer
TINKER_API_KEY=
TINKER_MODEL_PATH=           # tinker://... sampler checkpoint from finetune/
TINKER_BASE_MODEL=Qwen/Qwen3-8B
TINKER_RENDERER=qwen3_disable_thinking   # must match finetune/train.py

# SerpApi Google Shopping competitor prices
SERPAPI_KEY=
